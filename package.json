{
  "name": "@whosydd/pi-subagents",
  "version": "0.1.0",
  "description": "Sub-agents for pi: delegate tasks to autonomous child agents, with Jev (TypeSafe) calibrated model routing and result verification.",
  "type": "module",
  "license": "MIT",
  "author": "whosydd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whosydd/pi-subagents.git"
  },
  "homepage": "https://github.com/whosydd/pi-subagents#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagents",
    "agents",
    "jev",
    "typesafe"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node smoke/load.ts",
    "check": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^26.4.1",
    "typebox": "^1.3.27",
    "typescript": "^7.0.2"
  }
}

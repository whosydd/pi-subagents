{
  "name": "@whosydd/pi-subagents",
  "version": "0.1.0",
  "description": "Sub-agents for pi: delegate tasks to autonomous child agents with their own context, model, and tools.",
  "type": "module",
  "license": "MIT",
  "author": "whosydd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whosydd/pi-subagents.git"
  },
  "homepage": "https://github.com/whosydd/pi-subagents#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagents",
    "agents"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node smoke/load.ts",
    "check": "npm run typecheck && npm run test && npm run smoke"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.3",
    "@earendil-works/pi-coding-agent": "^1.0.3",
    "@types/node": "^26.4.1",
    "typebox": "^1.3.27",
    "typescript": "^7.0.2"
  }
}
